#
# Optional settings for ArchiveAutomation. Copy to etc\archiveautomation.cfg
# only if you need to change them; without this file the defaults are used.
#

[PATHS]
# The accession register (one row per accession). Default:
#   register\accession_register.csv in the ArchiveAutomation folder.
# register = C:\Tools\ArchiveAutomation\register\accession_register.csv

# The shared vocabulary folder. Default: vocabulary\ in the ArchiveAutomation folder.
# vocabulary = C:\Tools\ArchiveAutomation\vocabulary
